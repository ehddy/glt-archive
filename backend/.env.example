# ── Database ──────────────────────────────────────────────
# 로컬 개발 (SQLite)
DATABASE_URL=sqlite:///./quotes.db

# Supabase (PostgreSQL) — docs/SUPABASE_SETUP.md 참고
# Session pooler (5432): 동시 연결 15개 제한. 로컬+배포 동시 실행 시 한쪽이 실패할 수 있음.
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres
# Transaction pooler (6543, 권장): 동시 요청에 더 안정적
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres

# ── Read cache (서버 메모리 TTL) ─────────────────────────
# CACHE_ENABLED=true
# CACHE_TTL_SECONDS=60

# ── CORS (배포 시 Vercel 등에서 설정) ───────────────────
# 미설정 시 로컬 127.0.0.1 / localhost 만 허용
# CORS_ORIGINS=https://glt-archive.vercel.app
# 여러 개: CORS_ORIGINS=https://a.vercel.app,https://your-domain.com

# ── Gemini API (책 추천 챗봇) ───────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# ── 알라딘 Open API (도서 검색·등록) ─────────────────────
# https://www.aladin.co.kr/ttb/wguide.aspx
ALADIN_TTB_KEY=your_aladin_ttb_key_here
