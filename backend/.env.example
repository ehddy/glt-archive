# ── Database ──────────────────────────────────────────────
# 로컬 개발 (SQLite)
DATABASE_URL=sqlite:///./quotes.db

# Supabase (PostgreSQL) — docs/SUPABASE_SETUP.md 참고
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# ── Gemini API (책 추천 챗봇) ───────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# ── 알라딘 Open API (도서 검색·등록) ─────────────────────
# https://www.aladin.co.kr/ttb/wguide.aspx
ALADIN_TTB_KEY=your_aladin_ttb_key_here
